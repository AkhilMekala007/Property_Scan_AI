{
  "$defs": {
    "Adjacency": {
      "additionalProperties": false,
      "properties": {
        "room_a": {
          "title": "Room A",
          "type": "integer"
        },
        "room_b": {
          "title": "Room B",
          "type": "integer"
        },
        "via": {
          "enum": [
            "door",
            "opening",
            "window",
            "doorway",
            "open boundary"
          ],
          "title": "Via",
          "type": "string"
        },
        "opening_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Opening Id"
        }
      },
      "required": [
        "room_a",
        "room_b",
        "via",
        "opening_id"
      ],
      "title": "Adjacency",
      "type": "object"
    },
    "CaptureInfo": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "tier": {
          "enum": [
            "lidar",
            "video",
            "photo"
          ],
          "title": "Tier",
          "type": "string"
        },
        "source_format": {
          "title": "Source Format",
          "type": "string"
        },
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Device"
        },
        "device_supported": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Device Supported"
        },
        "duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration S"
        },
        "frames_raw": {
          "title": "Frames Raw",
          "type": "integer"
        },
        "keyframes_used": {
          "title": "Keyframes Used",
          "type": "integer"
        },
        "quality_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Quality Score",
          "type": "number"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/QcIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "id",
        "tier",
        "source_format",
        "device",
        "device_supported",
        "duration_s",
        "frames_raw",
        "keyframes_used",
        "quality_score",
        "issues",
        "warnings"
      ],
      "title": "CaptureInfo",
      "type": "object"
    },
    "Damage": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "surface_id": {
          "title": "Surface Id",
          "type": "string"
        },
        "room_id": {
          "title": "Room Id",
          "type": "integer"
        },
        "class": {
          "enum": [
            "water_stain",
            "crack",
            "mold"
          ],
          "title": "Class",
          "type": "string"
        },
        "area": {
          "$ref": "#/$defs/Measure"
        },
        "length": {
          "$ref": "#/$defs/Measure"
        },
        "extent_m": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Extent M",
          "type": "array"
        },
        "bottom_above_floor_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bottom Above Floor M"
        },
        "polygon_surface": {
          "description": "outline in surface coordinates: (along wall, height) for walls, (u, v) for floor / ceiling",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Polygon Surface",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "views": {
          "title": "Views",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "surface_id",
        "room_id",
        "class",
        "area",
        "length",
        "extent_m",
        "bottom_above_floor_m",
        "polygon_surface",
        "confidence",
        "views"
      ],
      "title": "Damage",
      "type": "object"
    },
    "DriftInfo": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
