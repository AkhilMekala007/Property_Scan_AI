  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "capture": {
      "$ref": "#/$defs/CaptureInfo"
    },
    "processing": {
      "$ref": "#/$defs/Processing"
    },
    "property": {
