          "title": "Max Translation M",
          "type": "number"
        },
        "max_yaw_deg": {
          "title": "Max Yaw Deg",
          "type": "number"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Note"
        }
      },
      "required": [
        "enabled",
        "loops_accepted",
        "loops_tested",
        "max_translation_m",
        "max_yaw_deg",
        "note"
      ],
      "title": "DriftInfo",
      "type": "object"
    },
    "Flag": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "damage_id": {
          "title": "Damage Id",
          "type": "integer"
        },
        "surface_id": {
          "title": "Surface Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Severity",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "recommendation": {
          "title": "Recommendation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "rule_id",
        "damage_id",
        "surface_id",
        "severity",
        "reason",
        "recommendation"
      ],
      "title": "Flag",
      "type": "object"
    },
    "Measure": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "lo": {
          "description": "lower end of the interval",
          "title": "Lo",
          "type": "number"
        },
        "hi": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "upper end; null for a lower bound (e.g. a door head never seen)",
          "title": "Hi"
        },
        "sigma": {
          "description": "one-sigma uncertainty used to build the interval",
          "minimum": 0,
          "title": "Sigma",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "confidence": {
          "default": 0.9,
          "title": "Confidence",
          "type": "number"
        },
        "bound": {
          "default": "two_sided",
          "enum": [
            "two_sided",
            "lower"
          ],
          "title": "Bound",
          "type": "string"
        },
        "calibrated": {
          "default": false,
          "title": "Calibrated",
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "lo",
        "hi",
        "sigma",
        "unit"
      ],
      "title": "Measure",
      "type": "object"
    },
    "ModelUsed": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        },
        "licence": {
          "title": "Licence",
          "type": "string"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "key",
        "repo",
        "licence",
        "purpose"
      ],
      "title": "ModelUsed",
      "type": "object"
    },
    "Opening": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "type": {
          "enum": [
            "door",
            "window",
            "opening"
          ],
          "title": "Type",
          "type": "string"
        },
        "rooms": {
          "items": {
            "type": "integer"
          },
          "title": "Rooms",
          "type": "array"
        },
        "wall_ids": {
          "items": {
            "type": "string"
