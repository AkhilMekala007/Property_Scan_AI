          "title": "Wall Ids",
          "type": "array"
        },
        "width": {
          "$ref": "#/$defs/Measure"
        },
        "height": {
          "$ref": "#/$defs/Measure"
        },
        "sill": {
          "anyOf": [
            {
              "$ref": "#/$defs/Measure"
            },
            {
              "type": "null"
            }
          ]
        },
        "center_xz": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center Xz",
          "type": "array"
        },
        "views": {
          "title": "Views",
          "type": "integer"
        },
        "covered": {
          "description": "seen only via labels (closed door, curtain)",
          "title": "Covered",
          "type": "boolean"
        },
        "low_evidence": {
          "title": "Low Evidence",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "rooms",
        "wall_ids",
        "width",
        "height",
        "sill",
        "center_xz",
        "views",
        "covered",
        "low_evidence"
      ],
      "title": "Opening",
      "type": "object"
    },
    "Processing": {
      "additionalProperties": false,
      "properties": {
        "pipeline_version": {
          "title": "Pipeline Version",
          "type": "string"
        },
        "run_utc": {
          "title": "Run Utc",
          "type": "string"
        },
        "runtime_s": {
          "title": "Runtime S",
          "type": "number"
        },
        "offline": {
          "default": true,
          "title": "Offline",
          "type": "boolean"
        },
        "interval_method": {
          "title": "Interval Method",
          "type": "string"
        },
        "calibrated": {
          "title": "Calibrated",
          "type": "boolean"
        },
        "drift_correction": {
          "$ref": "#/$defs/DriftInfo"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/ModelUsed"
          },
          "title": "Models",
          "type": "array"
        }
