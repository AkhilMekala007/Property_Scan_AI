        "polygon_xz": {
          "description": "corners in metres, world x/z, in order",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Polygon Xz",
          "type": "array"
