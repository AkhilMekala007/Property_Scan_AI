      "required": [
        "pipeline_version",
        "run_utc",
        "runtime_s",
        "interval_method",
        "calibrated",
        "drift_correction",
        "models"
      ],
      "title": "Processing",
      "type": "object"
    },
    "PropertyPlan": {
      "additionalProperties": false,
      "properties": {
        "rooms_count": {
          "title": "Rooms Count",
          "type": "integer"
        },
        "net_floor_area": {
          "$ref": "#/$defs/Measure"
        },
        "footprint_area": {
          "$ref": "#/$defs/Measure"
        },
        "connected": {
          "title": "Connected",
          "type": "boolean"
        },
        "adjacency": {
          "items": {
            "$ref": "#/$defs/Adjacency"
          },
          "title": "Adjacency",
          "type": "array"
        },
        "shared_walls": {
          "items": {
            "$ref": "#/$defs/SharedWall"
          },
          "title": "Shared Walls",
          "type": "array"
        },
        "overlaps": {
          "description": "(room a, room b, m2); empty when rooms do not overlap",
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Overlaps",
          "type": "array"
        },
        "unmeasured_doorways": {
          "title": "Unmeasured Doorways",
          "type": "integer"
        }
      },
      "required": [
        "rooms_count",
        "net_floor_area",
        "footprint_area",
        "connected",
        "adjacency",
        "shared_walls",
        "overlaps",
        "unmeasured_doorways"
      ],
      "title": "PropertyPlan",
      "type": "object"
    },
    "QcIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "fix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
