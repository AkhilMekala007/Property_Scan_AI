        "floor_tilt_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Floor Tilt Deg"
        },
        "walls": {
          "items": {
            "$ref": "#/$defs/Wall"
          },
          "title": "Walls",
          "type": "array"
        },
        "floor_id": {
          "title": "Floor Id",
          "type": "string"
        },
        "ceiling_id": {
          "title": "Ceiling Id",
          "type": "string"
        },
        "opening_ids": {
          "items": {
            "type": "integer"
          },
          "title": "Opening Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "polygon_xz",
        "floor_area",
        "perimeter",
        "ceiling_height",
        "ceiling_note",
        "floor_tilt_deg",
        "walls",
        "floor_id",
        "ceiling_id",
        "opening_ids"
